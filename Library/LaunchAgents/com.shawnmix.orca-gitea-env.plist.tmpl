<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shawnmix.orca-gitea-env</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>{{ .chezmoi.homeDir }}/.config/orca/load-gitea-env.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/orca-gitea-env.log</string>
    <key>StandardErrorPath</key>
    <string>{{ .chezmoi.homeDir }}/Library/Logs/orca-gitea-env.log</string>
</dict>
</plist>
