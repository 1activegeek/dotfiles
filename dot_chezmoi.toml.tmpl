{{- $profile := promptStringOnce . "profile" "Machine profile (personal/work)" -}}
{{- $name    := promptStringOnce . "name"    "Git full name" -}}
{{- $email   := promptStringOnce . "email"   "Git email address" -}}

[data]
  profile = {{ $profile | quote }}
  name    = {{ $name    | quote }}
  email   = {{ $email   | quote }}

[onepassword]
  command = "op"

[edit]
  command = "code"
  args    = ["--wait"]

[diff]
  pager = "less -R"
