# ~/.zshrc - Interactive shell configuration
# Loads modular config files from ~/.zshrc.d/ then initialises tools.

# ============================================
# Modular configuration loader
# ============================================
# Files are sourced in alphanumeric order (01-history first, 15-zoxide last)
if [[ -d "${HOME}/.zshrc.d" ]]; then
  for _zsh_config in "${HOME}/.zshrc.d"/*.zsh(N); do
    # shellcheck source=/dev/null
    source "$_zsh_config"
  done
  unset _zsh_config
fi

# ============================================
# Homebrew ZSH completions
# Must come before compinit
# ============================================
if command -v brew &>/dev/null; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

# ============================================
# ZSH completions
# ============================================
autoload -Uz compinit
# Regenerate dump file only once per day
if [[ -n "${ZDOTDIR:-${HOME}}/.zcompdump"(N.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# ============================================
# ZSH plugins (installed via Homebrew)
# ============================================
# zsh-autosuggestions — Fish-style inline suggestions
_zsh_autosuggestions="$(brew --prefix 2>/dev/null)/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -f "$_zsh_autosuggestions" ]] && source "$_zsh_autosuggestions"
unset _zsh_autosuggestions

# zsh-syntax-highlighting — MUST be sourced last
_zsh_syntax="$(brew --prefix 2>/dev/null)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ -f "$_zsh_syntax" ]] && source "$_zsh_syntax"
unset _zsh_syntax

# ============================================
# Starship prompt — MUST be at the very end
# ============================================
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi
