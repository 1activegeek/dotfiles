# ~/.zshrc.d/02-aliases.zsh
# Generic shell aliases

# ============================================
# Navigation
# ============================================
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Quick jump to common locations
alias icd="cd \"/Users/${USER}/Library/Mobile Documents/com~apple~CloudDocs/Documents\""
alias vault="cd \"/Users/${USER}/Library/Mobile Documents/iCloud~md~obsidian/Documents/lifeOS\""

# ============================================
# File listing (eza replaces ls)
# ============================================
if command -v eza &>/dev/null; then
  alias ls='eza --long --group-directories-first --icons=auto'
  alias ll='eza -la --icons --git --group-directories-first'
  alias la='eza -a --icons'
  alias l='eza -1 --icons'
  alias lt='eza --tree --icons --level=2'
  alias lta='eza --tree --icons --level=3 -a'
else
  # Fallback to standard ls with colors
  alias ls='ls -G'
  alias ll='ls -lahG'
  alias la='ls -AG'
  alias l='ls -CG'
fi

# ============================================
# bat replaces cat
# ============================================
if command -v bat &>/dev/null; then
  alias cat='bat'
fi

# ============================================
# Shell management
# ============================================
alias reload='exec zsh'
alias sz='source ~/.zshrc'
alias path='echo -e "${PATH//:/\\n}"'
alias cls='clear'

# ============================================
# Safety
# ============================================
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'
alias mkdir='mkdir -pv'

# ============================================
# Misc
# ============================================
alias j='jobs -l'
alias ports='lsof -i -n -P | grep LISTEN'
alias please='sudo $(fc -ln -1)'
alias week='date +%V'
alias timestamp='date "+%Y-%m-%d %H:%M:%S"'
alias f='fzf'

# ============================================
# AI / dev tools
# ============================================
alias c='claude'
alias cy='claude --dangerously-skip-permissions'
alias oc='opencode'
alias ch='chezmoi'
alias chstatus='chezmoi cd && git status --short && cd -'

# agentOS — launch Claude Code with the LifeOS vault as project root from any directory.
# ("agentos" = the OS; Ori→Jarvis was the old orchestrator persona.)
#   agentos     — everyday launch, default model, opens agents-mode view (spin up / see running agents)
#   agentos_qc  — opusplan + remote-control (the old jarvis()/opusplan+rc launcher)
#  Vault root resolved at runtime via the $VAULT_PATH contract (~/.agentos/.vault-path),
#  not hardcoded — per the harness-extraction doctrine (portable across machines).
#  Skills are the harness's own concern: they live in ~/.agents/skills and are linked into
#  ~/.claude/skills by chezmoi's run_after_12. No pre-launch reconcile step (2026-07-17).
agentos() { ( VP="$(cat ~/.agentos/.vault-path 2>/dev/null)"; cd "${VP:-$HOME}" && cy --model default agents "$@"); }
agentos_qc() { ( VP="$(cat ~/.agentos/.vault-path 2>/dev/null)"; cd "${VP:-$HOME}" && cy --remote-control agentOS_qc --model opusplan "$@"); }

# ============================================
# Quick edit common config files
# ============================================
alias ez='${EDITOR:-zed} ~/.zshrc'
alias zshd='${EDITOR:-zed} ~/.zshrc.d/'
