# ~/.zshrc.d/02-aliases.zsh
# Generic shell aliases

# ============================================
# Navigation
# ============================================
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# Quick jump to common locations
alias icd="cd \"/Users/${USER}/Library/Mobile Documents/com~apple~CloudDocs/Documents\""
alias vault="cd \"/Users/${USER}/Library/Mobile Documents/iCloud~md~obsidian/Documents/lifeOS\""

# ============================================
# File listing (eza replaces ls)
# ============================================
if command -v eza &>/dev/null; then
  alias ls='eza --long --group-directories-first --icons=auto'
  alias ll='eza -la --icons --git --group-directories-first'
  alias la='eza -a --icons'
  alias l='eza -1 --icons'
  alias lt='eza --tree --icons --level=2'
  alias lta='eza --tree --icons --level=3 -a'
else
  # Fallback to standard ls with colors
  alias ls='ls -G'
  alias ll='ls -lahG'
  alias la='ls -AG'
  alias l='ls -CG'
fi

# ============================================
# bat replaces cat
# ============================================
if command -v bat &>/dev/null; then
  alias cat='bat'
fi

# ============================================
# Shell management
# ============================================
alias reload='exec zsh'
alias sz='source ~/.zshrc'
alias path='echo -e "${PATH//:/\\n}"'
alias cls='clear'

# ============================================
# Safety
# ============================================
alias rm='rm -i'
alias mv='mv -i'
alias cp='cp -i'
alias mkdir='mkdir -pv'

# ============================================
# Misc
# ============================================
alias j='jobs -l'
alias ports='lsof -i -n -P | grep LISTEN'
alias please='sudo $(fc -ln -1)'
alias week='date +%V'
alias timestamp='date "+%Y-%m-%d %H:%M:%S"'
alias f='fzf'

# ============================================
# AI / dev tools
# ============================================
alias c='claude'
alias cy='claude --dangerously-skip-permissions'
alias oc='opencode'
alias ch='chezmoi'
alias chstatus='chezmoi cd && git status --short && cd -'

# agentOS — launch Claude Code with LifeOS vault as project root from any directory.
# Reconciles the skill library to its manifest (skill_manager.py sync) before launching.
# (Renamed from ori* — "Ori" was the orchestrator's old name, now Jarvis; the launcher
#  starts an agentOS session, so it's named for the OS. Sync uses `;` so a sync hiccup
#  never blocks launch.)
agentos_s() { (cd "{{ .chezmoi.homeDir }}/Library/Mobile Documents/iCloud~md~obsidian/Documents/lifeOS" && python3 agentOS/scripts/skill_manager.py sync --quiet 2>/dev/null; cy --remote-control agentOS_s --model opusplan "$@"); }
agentos_h() { (cd "{{ .chezmoi.homeDir }}/Library/Mobile Documents/iCloud~md~obsidian/Documents/lifeOS" && python3 agentOS/scripts/skill_manager.py sync --quiet 2>/dev/null; cy --remote-control agentOS_h --model haiku "$@"); }
agentos() { (cd "{{ .chezmoi.homeDir }}/Library/Mobile Documents/iCloud~md~obsidian/Documents/lifeOS" && python3 agentOS/scripts/skill_manager.py sync --quiet 2>/dev/null; cy --model opusplan "$@"); }
# backward-compat: old muscle-memory names still work (delete once you've adjusted)
alias ori='agentos'; alias ori_s='agentos_s'; alias ori_h='agentos_h'

# ============================================
# Quick edit common config files
# ============================================
alias ez='${EDITOR:-zed} ~/.zshrc'
alias zshd='${EDITOR:-zed} ~/.zshrc.d/'
