# .chezmoiignore
# Files/patterns to exclude from chezmoi management.
# Supports Go template syntax for conditional exclusion.

# Always ignore these
README.md
LICENSE
**/.DS_Store
bootstrap.sh
docs/
TODO.md
Brewfile.current
AGENTS.md
# One-time machine setup — run by bootstrap.sh / setup/setup.sh, never deployed
setup
setup/**

# Exclude non-macOS files on non-macOS
{{- if ne .chezmoi.os "darwin" }}
dot_zshrc.d/11-kube-ps1.zsh
dot_config/ghostty/
{{- end }}

# Profile-conditional ignores
{{- if eq .profile "work" }}
# SSH config is managed separately on work machines — don't overwrite it.
# To pull from 1Password manually: op read 'op://Private/SSH Config/notesPlain' > ~/.ssh/config
.ssh/config
# Home-lab secrets must NOT land on a work machine. Both are pulled from
# 1Password and are personal / home-ops only — gate them off the work profile.
.kube/config
.config/sops/age/home-ops.key
{{- end }}

# Never track the .agents inner git repo
.agents/.git
.agents/.git/**

# .agents/context holds personal DNA + employer (Proofpoint) brand/IP material.
# This repo is PUBLIC — never publish context here. Back it up privately instead.
.agents/context
.agents/context/**

# Private files rendered from 1Password notes (.chezmoidata/private_notes.yaml).
# Only on personal machines that opted in with [data] privateNotes = true.
{{- if not (and (eq .profile "personal") (hasKey . "privateNotes") .privateNotes) }}
.agents/identity
.claude/scheduled-tasks
{{- range .private_notes }}
{{ .target }}
{{- end }}
{{- end }}

# 1Password skipped during bootstrap (DOTFILES_SKIP_1PASSWORD=1): skip every
# file whose template calls onepasswordRead, so apply can finish without it.
{{- if env "DOTFILES_SKIP_1PASSWORD" }}
.ssh/config
.kube/config
.config/sops/age/home-ops.key
{{- range .private_notes }}
{{ .target }}
{{- end }}
{{- end }}
