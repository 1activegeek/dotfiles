# .chezmoiignore
# Files/patterns to exclude from chezmoi management.
# Supports Go template syntax for conditional exclusion.

# Always ignore these
README.md
LICENSE
**/.DS_Store
bootstrap.sh
docs/
TODO.md
Brewfile.current

# Exclude non-macOS files on non-macOS
{{- if ne .chezmoi.os "darwin" }}
dot_zshrc.d/11-kube-ps1.zsh
dot_config/ghostty/
{{- end }}

# Profile-conditional ignores
{{- if eq .profile "work" }}
# SSH config is managed separately on work machines — don't overwrite it.
# To pull from 1Password manually: op read 'op://Private/SSH Config/notesPlain' > ~/.ssh/config
.ssh/config
{{- end }}
