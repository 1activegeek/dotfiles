#!/bin/bash
# post-install-report.sh.tmpl
# Post-install report: package status, system summary, tasks, and notes.
# Rendered and run by bootstrap.sh at the end of every bootstrap run.

[[ "$(uname)" != "Darwin" ]] && exit 0

BUNDLE_LOG="${HOME}/.local/log/dotfiles-brew-bundle.log"

# ── Helpers ───────────────────────────────────────────────────────────────────

if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

PKG_PASS=0
PKG_FAIL=0

INSTALLED_FORMULAS="$(brew list --formula 2>/dev/null)"
INSTALLED_CASKS="$(brew list --cask 2>/dev/null)"
INSTALLED_MAS="$(mas list 2>/dev/null | awk '{print $1}')"

check_pkg() {
  local type="$1" ref="$2" display="$3"
  local brew_name="${ref##*/}"   # strip tap prefix: foo/tap/bar → bar
  local installed=false err=""

  case "$type" in
    brew) echo "$INSTALLED_FORMULAS" | grep -qx "$brew_name" && installed=true ;;
    cask) echo "$INSTALLED_CASKS"    | grep -qx "${ref##*/}" && installed=true ;;
    mas)  echo "$INSTALLED_MAS"      | grep -qx "$ref"       && installed=true ;;
  esac

  if $installed; then
    printf "  ✓  [%-4s]  %s\n" "$type" "$display"
    PKG_PASS=$((PKG_PASS + 1))
  else
    if [[ -f "$BUNDLE_LOG" ]]; then
      err=$(grep -iF "$brew_name" "$BUNDLE_LOG" 2>/dev/null \
            | grep -iE "error|warning|failed|not installed|no cask|no available" \
            | head -1 \
            | sed 's/^[[:space:]]*//' \
            | cut -c1-80)
    fi
    if [[ -n "$err" ]]; then
      printf "  ✗  [%-4s]  %-38s  → %s\n" "$type" "$display" "$err"
    else
      printf "  ✗  [%-4s]  %s\n" "$type" "$display"
    fi
    PKG_FAIL=$((PKG_FAIL + 1))
  fi
}

section() {
  echo ""
  echo "  ── $1 ──"
}

# ── Package Status ────────────────────────────────────────────────────────────

echo ""
echo "══════════════════════════════════════════════════════════════"
echo "  PACKAGE STATUS"
echo "══════════════════════════════════════════════════════════════"

{{ $profile := .profile }}
section "Formulae"
{{ range .formulae -}}
{{- if kindIs "string" . }}
check_pkg "brew" "{{ . }}" "{{ . }}"
{{ else if or (not (hasKey . "profiles")) (has $profile .profiles) }}
check_pkg "brew" "{{ .name }}" "{{ .name }}"
{{ end -}}
{{- end }}
section "Casks"
{{ range .casks -}}
{{- if kindIs "string" . }}
check_pkg "cask" "{{ . }}" "{{ . }}"
{{ else if or (not (hasKey . "profiles")) (has $profile .profiles) }}
check_pkg "cask" "{{ .name }}" "{{ .name }}"
{{ end -}}
{{- end }}
section "Mac App Store"
{{ range .mas -}}
{{- if or (not (hasKey . "profiles")) (has $profile .profiles) }}
check_pkg "mas" "{{ .id }}" "{{ .name }}"
{{ end -}}
{{- end }}

echo ""
echo "  ──────────────────────────────────────────────────────────"
echo "  ${PKG_PASS} installed  |  ${PKG_FAIL} not installed / failed"

# ── System Summary ────────────────────────────────────────────────────────────

echo ""
echo "══════════════════════════════════════════════════════════════"
echo "  SYSTEM SUMMARY"
echo "══════════════════════════════════════════════════════════════"
echo ""
echo "  System:"
printf "  %-22s %s\n" "Hostname:"        "$(scutil --get ComputerName 2>/dev/null || echo unknown)"
printf "  %-22s %s\n" "macOS:"           "$(sw_vers -productVersion)"
printf "  %-22s %s\n" "Profile:"         "{{ .profile }}"
printf "  %-22s %s\n" "Dotfiles date:"   "{{ output "git" "-C" .chezmoi.sourceDir "log" "-1" "--format=%cd" "--date=short" | trim }}"
printf "  %-22s %s\n" "Chezmoi:"         "$(chezmoi --version 2>/dev/null | head -1 || echo n/a)"

echo ""
echo "  Managed files:"
chezmoi managed --exclude=scripts 2>/dev/null | sort | awk -F'/' '
  {
    dir = (NF > 1) ? $1 : "(root)"
    files[dir] = files[dir] "\n    │  " $0
    if (!seen[dir]++) dirs[++n] = dir
  }
  END {
    for (i = 1; i <= n; i++) {
      print "  ├─ " dirs[i]
      print files[dirs[i]]
    }
  }
'

# ── Manual Tasks ──────────────────────────────────────────────────────────────

echo ""
echo "══════════════════════════════════════════════════════════════"
echo "  MANUAL TASKS"
echo "══════════════════════════════════════════════════════════════"
echo ""
{{ range .post_install_tasks -}}
echo "  [ ] {{ . }}"
{{ end }}

# ── Notes ─────────────────────────────────────────────────────────────────────

echo ""
echo "══════════════════════════════════════════════════════════════"
echo "  APP NOTES"
echo "══════════════════════════════════════════════════════════════"
{{ range .post_install_notes }}
echo ""
echo "  {{ .category }}"
{{ range .items -}}
echo "      • {{ . }}"
{{ end -}}
{{ end }}

# ── fastfetch ─────────────────────────────────────────────────────────────────

if command -v fastfetch &>/dev/null; then
  echo ""
  fastfetch
fi

echo ""
