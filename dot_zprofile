# ~/.zprofile - Login shell configuration
# Loaded once per login session (before .zshrc)
# Place environment setup, PATH modifications, and one-time evals here.

# ============================================
# Homebrew
# ============================================
# Apple Silicon: /opt/homebrew — Intel: /usr/local
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Don't prompt for Gatekeeper on cask installs
export HOMEBREW_CASK_OPTS="--no-quarantine"

# ============================================
# Editor
# ============================================
# Use VS Code locally; fall back to nano over SSH
if [[ -n "$SSH_CONNECTION" ]]; then
  export EDITOR='nano'
else
  export EDITOR='code --wait'
fi
export VISUAL="$EDITOR"

# ============================================
# Bun
# ============================================
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
# Bun shell completions
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"

# ============================================
# Go
# ============================================
if command -v brew &>/dev/null && brew --prefix go &>/dev/null 2>&1; then
  export GOROOT="$(brew --prefix go)/libexec"
  export GOPATH="$HOME/go"
  export PATH="$GOPATH/bin:$GOROOT/bin:$PATH"
fi

# ============================================
# opencode
# ============================================
export PATH="$HOME/.opencode/bin:$PATH"

# ============================================
# LM Studio CLI (lms)
# ============================================
export PATH="$PATH:$HOME/.lmstudio/bin"

# ============================================
# pipx / local bin
# ============================================
export PATH="$PATH:$HOME/.local/bin"

# ============================================
# OrbStack (Docker / Linux VMs)
# ============================================
[[ -f "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh" 2>/dev/null

# ============================================
# mise (runtime version manager)
# ============================================
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi
